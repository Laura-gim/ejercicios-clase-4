def verificar_cero(func):
    def wrapper(*args, **kwargs):
        if 0 in args:
            print("ERROR ERROR ERROR")
        return func(*args, **kwargs)
    return wrapper

@verificar_cero
def dividir(a, b):
    if b == 0:
        return "No se puede dividir por cero."
    return a / b


print(int(dividir(10, 2)) ) 
print(dividir(10, 0))  
